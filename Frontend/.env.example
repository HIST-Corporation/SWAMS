# SWAMS frontend — public environment variables (VITE_* are exposed to the browser by definition).
# Copy to .env.local for local work. Never put secrets here (see docs/ops/environment-variables.md).

# API base URL. Leave empty in local dev to use the MSW mock server (Section 5, mock-first).
VITE_API_URL=

# Force the MSW mock server on/off. Default: on when VITE_API_URL is empty.
VITE_MOCK=

# Public origin of the deployed app (used for links, PWA scope, analytics referrers).
VITE_APP_ORIGIN=http://localhost:5173

# Sentry DSN (browser SDK). Empty = error tracking disabled (no third-party requests).
VITE_SENTRY_DSN=

# Socket.IO endpoint for realtime hints. Empty = realtime disabled, REST only.
VITE_SOCKET_URL=
