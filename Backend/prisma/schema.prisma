// SWAMS Prisma schema — PostgreSQL, multi-tenant SaaS (master prompt).
// JavaScript-only: Prisma generates a JS client, no TS build step.
// Tenant isolation: every business row carries orgId; app scoping enforced.
// Nepal-first: Asia/Kathmandu timezone, BS calendar fields alongside AD dates.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Platform / tenancy ----------

model Org {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  timezone        String   @default("Asia/Kathmandu")
  fiscalYearStart String   @default("07-16")
  plan            String   @default("trial")
  seats           Int      @default(10)
  status          String   @default("trial")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  departments     Department[]
  teams           Team[]
  sites           Site[]
  shifts          Shift[]
  attendanceSessions AttendanceSession[]
  corrections     AttendanceCorrection[]
  leaveTypes      LeaveType[]
  leaveRequests   LeaveRequest[]
  leaveBalances   LeaveBalance[]
  holidays        Holiday[]
  tasks           Task[]
  taskLanes       TaskLane[]
  taskTemplates   TaskTemplate[]
  calendarEvents  CalendarEvent[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  invites         Invite[]
  aiRuns          AiRun[]
  idempotencyKeys IdempotencyKey[]
  files           FileRecord[]
  punches         Punch[]
  taskRevisions   TaskRevision[]

  requiresLocation Boolean @default(true)
  allowOverride    Boolean @default(false)

  @@map("orgs")
}

model Department {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  teams     Team[]

  @@unique([orgId, name])
  @@map("departments")
}

model Team {
  id           String      @id @default(cuid())
  orgId        String
  org          Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name         String
  leadId       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  members      User[]      @relation("TeamMembers")
  lead         User?       @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([orgId, name])
  @@map("teams")
}

model Site {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  lat       Float?
  lng       Float?
  radiusM   Int      @default(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name])
  @@map("sites")
}

model Shift {
  id             String   @id @default(cuid())
  orgId          String
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String   @default("Day shift")
  startTime      String   @default("09:30")
  endTime        String   @default("18:00")
  workdayMinutes Int      @default(510)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("shifts")
}

// ---------- Identity / auth ----------

model User {
  id            String    @id @default(cuid())
  orgId         String
  org           Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email         String
  passwordHash  String
  name          String
  initials      String    @default("")
  jobTitle      String    @default("")
  jobKey        String    @default("")
  staffRole     String?
  role          String    @default("staff")
  scope         String?
  locale        String    @default("en")
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site          String    @default("Kathmandu HQ")
  active        Boolean   @default(true)
  emailVerifiedAt DateTime?
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberTeams   Team[]    @relation("TeamMembers")
  leadingTeams  Team[]    @relation("TeamLead")
  refreshTokens RefreshToken[]
  attendanceSessions AttendanceSession[]
  corrections   AttendanceCorrection[] @relation("CorrectionRequester")
  decidedCorrections AttendanceCorrection[] @relation("CorrectionDecider")
  leaveRequests LeaveRequest[] @relation("LeaveRequester")
  decidedLeaves LeaveRequest[] @relation("LeaveDecider")
  assignedTasks Task[] @relation("TaskAssignee")
  reviewingTasks Task[] @relation("TaskReviewer")
  notifications Notification[]
  auditActors   AuditLog[] @relation("AuditActor")
  preferences   UserPreferences?
  entitlements  UserEntitlement[]

  @@unique([orgId, email])
  @@map("users")
}

model UserPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme     String   @default("system")
  language  String   @default("en")
  calendar  String   @default("bs")
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

model UserEntitlement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String

  @@unique([userId, key])
  @@map("user_entitlements")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String?
  familyId  String
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model Invite {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email     String
  role      String   @default("staff")
  tokenHash String   @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())

  @@map("invites")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@map("password_resets")
}

// ---------- Attendance ----------

model AttendanceSession {
  id             String    @id @default(cuid())
  orgId          String
  org            Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           String
  clockIn        DateTime?
  clockOut       DateTime?
  workedMinutes  Int?
  status         String    @default("present")
  exception      String?
  source         String    @default("web")
  lat            Float?
  lng            Float?
  siteId         String?
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([orgId, userId, date])
  @@index([orgId, date])
  @@map("attendance_sessions")
}

model AttendanceCorrection {
  id          String   @id @default(cuid())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User     @relation("CorrectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  date        String
  kind        String   @default("time")
  payload     Json     @default("{}")
  reason      String   @default("")
  status      String   @default("pending")
  deciderId   String?
  decider     User?    @relation("CorrectionDecider", fields: [deciderId], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, status])
  @@map("attendance_corrections")
}

// ---------- Leave ----------

model LeaveType {
  id       String  @id @default(cuid())
  orgId    String
  org      Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key      String
  name     String
  entitled Int     @default(0)
  active   Boolean @default(true)

  @@unique([orgId, key])
  @@map("leave_types")
}

model LeaveRequest {
  id          String   @id @default(cuid())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User     @relation("LeaveRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  typeKey     String
  from        String
  to          String
  days        Float    @default(1)
  reason      String   @default("")
  status      String   @default("pending")
  deciderId   String?
  decider     User?    @relation("LeaveDecider", fields: [deciderId], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, status])
  @@map("leave_requests")
}

model LeaveBalance {
  id       String @id @default(cuid())
  orgId    String
  org      Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId   String
  typeKey  String
  entitled Int    @default(0)
  used     Int    @default(0)
  pending  Int    @default(0)

  @@unique([orgId, userId, typeKey])
  @@map("leave_balances")
}

model Holiday {
  id      String  @id @default(cuid())
  orgId   String
  org     Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  date    String
  title   String
  titleNe String?
  scope   String  @default("national")
  region  String?
  regionLabel String?

  @@unique([orgId, date, title])
  @@map("holidays")
}

// ---------- Tasks / board ----------

model TaskLane {
  id       String  @id @default(cuid())
  orgId    String
  org      Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key      String
  name     String?
  position Int     @default(0)
  wipLimit Int?

  @@unique([orgId, key])
  @@map("task_lanes")
}

model Task {
  id          String   @id @default(cuid())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  lane        String   @default("todo")
  priority    String   @default("medium")
  kind        String   @default("review")
  status      String   @default("open")
  assigneeId  String?
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewerId  String?
  reviewer    User?    @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  due         String?
  note        String?
  closedAt    DateTime?
  meta        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  checklist   TaskChecklistItem[]

  @@index([orgId, lane])
  @@map("tasks")
}

model TaskChecklistItem {
  id     String  @id @default(cuid())
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title  String
  done   Boolean @default(false)

  @@map("task_checklist_items")
}

model TaskTemplate {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  @@map("task_templates")
}

// ---------- Calendar / events ----------

model CalendarEvent {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  date      String
  kind      String
  title     String
  audience  String?
  createdAt DateTime @default(now())

  @@index([orgId, date])
  @@map("calendar_events")
}

// ---------- Notifications ----------

model Notification {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  key       String
  params    Json     @default("{}")
  link      String?
  audience  String   @default("staff")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orgId, userId, read])
  @@map("notifications")
}

// ---------- Audit / platform / system ----------

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String?
  org       Org?     @relation(fields: [orgId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  entity    String
  action    String
  details   Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  @@index([orgId, action])
  @@map("audit_logs")
}

model PlatformAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  level        String    @default("support")
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())

  @@map("platform_admins")
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  orgId     String?
  org       Org?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key       String   @unique
  status    Int      @default(200)
  body      Json     @default("{}")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("idempotency_keys")
}

model FileRecord {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownerId   String
  kind      String
  url       String
  mime      String?
  size      Int?
  createdAt DateTime @default(now())

  @@map("files")
}

model AiRun {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  tool      String
  input     Json     @default("{}")
  output    Json     @default("{}")
  tokens    Int      @default(0)
  createdAt DateTime @default(now())

  @@map("ai_runs")
}

// ---------- Punch records (raw clock events; sessions hold the day rollup) ----------

model Punch {
  id             String    @id @default(cuid())
  orgId          String
  org            Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId         String
  date           String
  kind           String
  at             DateTime  @default(now())
  clientTs       DateTime?
  lat            Float?
  lng            Float?
  site           String?
  distanceM      Int?
  needsReview    Boolean   @default(false)
  reason         String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())

  @@index([orgId, userId, date])
  @@map("punches")
}

// ---------- Task revision trail (board push-backs) ----------

model TaskRevision {
  id         String   @id @default(cuid())
  orgId      String
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  taskId     String
  taskTitle  String
  issue      String   @default("")
  suggestion String   @default("")
  severity   String   @default("major")
  reviewer   String   @default("")
  date       String
  createdAt  DateTime @default(now())

  @@index([orgId, taskId])
  @@map("task_revisions")
}
