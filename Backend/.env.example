# SWAMS Backend — API (JavaScript-only Express modular monolith)
# Copy to .env and fill. Never commit real secrets.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL (Prisma). Example: postgresql://swams:swams@localhost:5432/swams?schema=public
DATABASE_URL=postgresql://swams:swams@localhost:5432/swams?schema=public

# Auth — access token (short-lived) + refresh rotation via httpOnly cookie
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookies
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS — comma-separated allowlist (frontend origins only)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Idempotency (punch + offline sync retries) — stored 24h
IDEMPOTENCY_TTL_HOURS=24

# Realtime (Socket.IO) — same origin policy enforced in gateway
SOCKET_CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Logging / observability
LOG_LEVEL=info
SENTRY_DSN=

# Object storage (one adapter at a time — S3-compatible default, Cloudinary optional)
STORAGE_ADAPTER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1
CLOUDINARY_URL=

# Email (Resend default per master prompt §13/19)
EMAIL_ADAPTER=resend
RESEND_API_KEY=
EMAIL_FROM=no-reply@swams.example.com

# Redis (optional — sessions/rate-limit/cache/realtime; file/DB fallback when absent)
REDIS_URL=

# AI gateway (R3 — provider-agnostic, deterministic first; empty = AI disabled with graceful fallback)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_TOKEN_BUDGET=1000000
