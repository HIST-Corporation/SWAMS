{
  "name": "swams-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SWAMS — Smart Workflow and Attendance Management System (backend API, JavaScript-only Express modular monolith)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "test:setup": "psql -h localhost -U swams -d postgres -c \"CREATE DATABASE swams_test;\" 2>/dev/null || true && DATABASE_URL=postgresql://swams:swams@localhost:5432/swams_test prisma migrate deploy --schema ./prisma/schema.prisma && DATABASE_URL=postgresql://swams:swams@localhost:5432/swams_test prisma db seed",
    "test:integration": "npm run test:setup && npm test",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "openapi:lint": "node scripts/lint-openapi.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.2.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.9",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0"
  }
}
